
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-sendToIndago-WaveWindow {
  usual
  position -pos 1
}
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set whats-new-dont-show-at-startup 1

#
# Databases
#
database require wave -search {
	./wave.shm/wave.trn
	/home/vvtrainee43/Desktop/Blueetooth/bluetooth/wave.shm/wave.trn
}

#
# Markers
#
set time 364ns
if {[catch {marker new -name  {Marker 1} -time $time}] != ""} {
    marker set -using {Marker 1} -time $time
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1366x665+-1+27}] != ""} {
    window geometry "Waveform 1" 1366x665+-1+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 79
waveform baseline set -time 0

set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.clk
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.rst_n
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.preset_en
	} ]
set id [waveform add -signals  {
	{wave::tb_serial_crc24.dut.preset_val[23:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.bit_en
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.din
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.last_bit
	} ]
set id [waveform add -signals  {
	{wave::tb_serial_crc24.dut.crc_out[23:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.crc_done
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.rx_compare_en
	} ]
set id [waveform add -signals  {
	{wave::tb_serial_crc24.dut.rx_crc_field[23:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_serial_crc24.dut.crc_match
	} ]

waveform xview limits 32ns 340ns

#
# Waveform Window Links
#

#
# Source Browser windows
#
if {[catch {window new SrcBrowser -name "Source Browser 2" -geometry 700x525+28+58}] != ""} {
    window geometry "Source Browser 2" 700x525+28+58
}
window target "Source Browser 2" on
srcbrowser using {Source Browser 2}
srcbrowser set \
    -primarycursor TimeA \
    -units ns \
    -radix default \
    -showstrength 0 \
    -showcallstack 0 \
    -displayvalues 0

srcbrowser show -scope tb_serial_crc24.dut -file /home/vvtrainee43/Desktop/Blueetooth/bluetooth/crc.sv -line 75

srcbrowser sidebar visibility partial

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+0

#
# Layout selection
#
